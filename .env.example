# TrackQA — environment template.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials — this file must only
# ever contain obvious placeholders. Each variable below is read via
# `process.env.*` in `src/` (see src/index.js, src/email.js, src/stripe.js).

# --- Database ---------------------------------------------------------------
# Prisma connection string (PostgreSQL / TimescaleDB).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Server -----------------------------------------------------------------
PORT=3000
# Public base URL of the app; used to build links in outgoing email.
APP_URL="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Long random string used to sign JWTs.
JWT_SECRET="<generate-a-long-random-secret>"

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="<your-stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<your-stripe-webhook-signing-secret>"
STRIPE_PRO_PRICE_ID="<your-pro-price-id>"
STRIPE_ENTERPRISE_PRICE_ID="<your-enterprise-price-id>"

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY="<your-resend-api-key>"
# Must be an address on a domain verified in Resend.
RESEND_FROM_EMAIL="you@example.com"
